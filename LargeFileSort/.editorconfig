root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,sln,yml,yaml,md,json}]
indent_style = space

[*.cs]
indent_size = 4
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

[*.{csproj,props,yml,yaml,json}]
indent_size = 2
